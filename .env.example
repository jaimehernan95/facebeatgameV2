# Optional: Server-side Gemini API key for AI beatmap choreography.
# Leave blank to run 100% locally with built-in procedural beatmaps.
GEMINI_API_KEY=

# Public base URL for OAuth callbacks (set automatically in hosted environments).
APP_URL=http://localhost:3000

# Optional: Spotify Developer App credentials for Spotify OAuth & playback.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
